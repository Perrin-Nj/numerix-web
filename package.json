{
  "name": "numerix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:api": "openapi-typescript contracts/openapi.yaml -o src/data/api/schema.d.ts",
    "gen:messages": "node scripts/build-messages.mjs",
    "predev": "pnpm gen:messages",
    "prebuild": "pnpm gen:messages",
    "prestorybook": "pnpm gen:messages",
    "typecheck": "tsc --noEmit",
    "check:stories": "node scripts/check-stories.mjs",
    "check:copy": "node scripts/build-messages.mjs && node scripts/check-copy.mjs",
    "check:sounds": "node scripts/check-sounds.mjs",
    "check:art": "node scripts/no-cartoon-check.mjs",
    "check:ip": "node scripts/check-client-ip.mjs",
    "check:env": "node scripts/check-env-examples.mjs",
    "vercel:env": "node scripts/vercel-env.mjs",
    "check": "pnpm check:stories && pnpm check:copy && pnpm check:sounds && pnpm check:art && pnpm check:ip && pnpm check:env && pnpm typecheck && pnpm lint",
    "smoke:errors": "node scripts/smoke-errors.mjs",
    "flows": "node scripts/flows.mjs",
    "ui-checks": "node scripts/ui-checks.mjs",
    "dev:next": "next dev",
    "test": "bash scripts/test.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.17",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.9.0",
    "lucide-react": "^1.55.0",
    "matter-js": "0.20.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/matter-js": "0.20.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.12.0",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-storybook": "^10.6.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^4"
  },
  "packageManager": "pnpm@10.33.0"
}