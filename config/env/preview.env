# Vercel preview variables (no secrets). Push with: pnpm vercel:env push preview
API_URL=https://numerix-mock.vercel.app/v1
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_STATE_SOURCE=local
NEXT_PUBLIC_APP_ENV=preview
NEXT_PUBLIC_DEFAULT_LOCALE=fr-CA
NEXT_PUBLIC_LOCALES=fr-CA,en-CA
NEXT_PUBLIC_MASCOT_ENABLED=true
NEXT_PUBLIC_MASCOT_KIND=emoji
NEXT_PUBLIC_MASCOT_EMOJI=🦊
NEXT_PUBLIC_FEATURE_FEED=true
NEXT_PUBLIC_FEATURE_KIOSK=true
NEXT_PUBLIC_FEATURE_TV=true
NEXT_PUBLIC_FEATURE_READ_ALOUD=true
NEXT_PUBLIC_SOUND_DEFAULT=true
NEXT_PUBLIC_ANALYTICS_ENABLED=true
