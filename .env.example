# Numerix web configuration. Every variable is validated in src/config/env.ts.
# Copy to .env.local for local development. On Vercel use scripts/vercel-env.mjs.

# Server only: base URL of the backend (the Go API, :8081 locally)
API_URL=http://localhost:8081/v1

# development | preview | production
NEXT_PUBLIC_APP_ENV=development

# Where progress comes from: local (on-device game state) or api (the server owns it)

# Languages (device language first, then the default)
NEXT_PUBLIC_DEFAULT_LOCALE=fr-CA
NEXT_PUBLIC_LOCALES=fr-CA,en-CA

# Mascot: kind is owl | emoji | image | rive (owl is Numa, drawn in code)
NEXT_PUBLIC_MASCOT_ENABLED=true
NEXT_PUBLIC_MASCOT_KIND=owl

# Server only: comma separated hostnames allowed for remote images (empty until real art exists)
IMAGE_HOSTS=

# Feature flags
NEXT_PUBLIC_FEATURE_FEED=true
NEXT_PUBLIC_FEATURE_KIOSK=true
NEXT_PUBLIC_FEATURE_TV=true
NEXT_PUBLIC_FEATURE_READ_ALOUD=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTION_UI=false
NEXT_PUBLIC_FEATURE_WELCOME_GIFT=false

# Defaults for new profiles
NEXT_PUBLIC_SOUND_DEFAULT=true
NEXT_PUBLIC_ANALYTICS_ENABLED=true
