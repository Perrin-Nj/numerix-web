{
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/v1/auth/login",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.password == 'wrong-password')]"
      }
    ]
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "jsonBody": {
      "type": "https://numerix.app/problems/unauthorized",
      "title": "Wrong email or password",
      "status": 401,
      "detail": "Check your details and try again.",
      "code": "unauthorized"
    }
  }
}
