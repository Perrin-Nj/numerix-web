{
  "priority": 1,
  "request": {
    "urlPathPattern": "/v1/.*",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "server-error"
      }
    }
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "jsonBody": {
      "type": "https://numerix.app/problems/internal-error",
      "title": "Something went wrong",
      "status": 500,
      "detail": "The server could not complete the request.",
      "code": "internal_error"
    }
  }
}
