{
  "priority": 5,
  "request": {
    "method": "PUT",
    "urlPathPattern": "/v1/children/[^/]+/settings"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{{{request.body}}}",
    "transformers": [
      "response-template"
    ]
  }
}
