{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/sessions/.*/narration.*",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "narration-slow"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache"
    },
    "body": "event: done\ndata: {}\n\n",
    "transformers": [
      "response-template"
    ],
    "chunkedDribbleDelay": {
      "numberOfChunks": 8,
      "totalDuration": 1400
    },
    "fixedDelayMilliseconds": 9000
  }
}
