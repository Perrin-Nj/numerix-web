{
  "priority": 1,
  "request": {
    "urlPathPattern": "/v1/.*",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "rate-limited"
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "jsonBody": {
      "type": "https://numerix.app/problems/rate-limited",
      "title": "Too many requests",
      "status": 429,
      "detail": "Slow down and try again.",
      "code": "rate_limited"
    }
  }
}
