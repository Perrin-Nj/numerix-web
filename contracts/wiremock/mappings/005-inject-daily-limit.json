{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/children/[^/]+/sessions",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "daily-limit"
      }
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "jsonBody": {
      "type": "https://numerix.app/problems/daily-limit-reached",
      "title": "Daily limit reached",
      "status": 403,
      "detail": "The daily time limit is reached.",
      "code": "daily_limit_reached"
    }
  }
}
