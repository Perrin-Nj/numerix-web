{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/v1/auth/register"
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "mock-parent-token",
      "refresh_token": "mock-refresh-token",
      "expires_in": 3600,
      "parent": {
        "id": "99999999-9999-4999-8999-999999999999",
        "email": "{{jsonPath request.body '$.email'}}",
        "locale": "fr-CA"
      }
    },
    "transformers": [
      "response-template"
    ]
  }
}
