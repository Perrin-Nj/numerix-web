{
  "priority": 1,
  "request": {
    "urlPathPattern": "/v1/(children|sessions|reports|worlds|skills).*",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "unauthorized"
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "jsonBody": {
      "type": "https://numerix.app/problems/unauthorized",
      "title": "Session ended",
      "status": 401,
      "detail": "The access token is missing or expired.",
      "code": "unauthorized"
    }
  }
}
