# Required at admin runtime. Use a unique password and secrets per environment.
ADMIN_PASSWORD=
# openssl rand -hex 32; required, at least 32 characters.
ADMIN_SESSION_SECRET=
# Use HTTPS, except for a trusted local API on the same VM.
PLATFORM_API_URL=http://127.0.0.1:8081
# Generate once with openssl rand -hex 32; copy the same value to API ADMIN_API_TOKEN.
ADMIN_API_TOKEN=
